# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Data directories (raw datasets and large binary artifacts are ignored)
data/raw/
data/processed/*.parquet
data/processed/smoke_test/
data/processed/sim_smoke_test/
data/processed/sim_runs/
data/processed/temp_hourly_sims/
data/processed/temp_aug_sims/
data/processed/vent_check_test/
models/*.joblib
models/*.json
models/*.pkl

# Explicitly track essential configuration, metric summaries, and split artifacts
!data/processed/*.csv
!data/processed/*.json

# Environments
.venv/
venv/
ENV/

# OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
