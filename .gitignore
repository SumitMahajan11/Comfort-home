# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Scratch & temporary development scripts
scratch/

# Environments & IDEs
.venv/
venv/
ENV/
.env
.DS_Store
Thumbs.db
.vscode/
.idea/

# Raw datasets (weather EPW files, raw survey archives)
data/raw/

# Transient and bulky simulation directories
data/processed/scaling/
data/processed/scaling_test*/
data/processed/pilot/
data/processed/smoke_test/
data/processed/sim_*/
data/processed/ver_*/
data/processed/temp_*/
data/processed/vent_check_test/
sim_*/
ver_*/

# Large binary & parquet artifacts
data/processed/*.parquet
hourly_*.parquet
archive_*.zip

# Models directory (binary serialized models)
models/

# Runtime telemetry, batch logs, and memory traces
reports/mem_trace*.csv
reports/batch_log*.csv
reports/batch_errors.log

# Explicitly track essential configuration, metric summaries, and split artifacts
!data/processed/*.csv
!data/processed/*.json
